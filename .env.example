# AI Platform Web Console — Environment Variables
# Copy to .env.local for local development

# API Base URL (留空则使用 /api/v1，由 vercel.json rewrite 到后端)
# 部署时设置为 Railway 后端地址，例如：
# VITE_API_BASE_URL=https://ai-platform-api.up.railway.app/api/v1
VITE_API_BASE_URL=

# ─── Sentry Error Monitoring (optional) ──────────────────────────────
# Create a project at https://sentry.io and copy these values.
# VITE_SENTRY_DSN is the public DSN — safe to embed in client bundles.
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT are build-time only —
# they're used by @sentry/vite-plugin to upload source maps and are
# never exposed to the browser.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
VITE_SENTRY_RELEASE=

# Build-time env vars (set in CI/CD, not in .env.local)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=web-console
# SENTRY_RELEASE=v0.1.0
