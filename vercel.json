{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ai-platform-api-production-19cb.up.railway.app/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://ai-platform-api-production-19cb.up.railway.app/health"
    },
    {
      "source": "/live",
      "destination": "https://ai-platform-api-production-19cb.up.railway.app/live"
    },
    {
      "source": "/metrics",
      "destination": "https://ai-platform-api-production-19cb.up.railway.app/metrics"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Content-Security-Policy", "value": "upgrade-insecure-requests" }]
    }
  ]
}
